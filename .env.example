# ---------------------------------------------------------------------------
# Thunaiy environment configuration (copy to .env.local and fill in).
# Never commit real secrets. Only VITE_* values reach the browser bundle, so
# never put an API secret, SMS provider key or database URL in a VITE_* var.
# ---------------------------------------------------------------------------

# Base URL of the Thunaiy API (e.g. https://api.thunaiy.example/v1).
# Leave empty to run against the in-browser development backend.
VITE_API_BASE_URL=

# "dev"  -> in-browser development backend (no SMS is sent; OTP shown on screen)
# "api"  -> real HTTP backend at VITE_API_BASE_URL
VITE_AUTH_MODE=dev

# Development-backend OTP policy (mirrors the server-side policy).
VITE_OTP_TTL_SECONDS=300
VITE_OTP_MAX_ATTEMPTS=5
VITE_OTP_RESEND_COOLDOWN_SECONDS=30
VITE_SESSION_TTL_HOURS=168
